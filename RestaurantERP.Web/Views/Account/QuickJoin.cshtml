@model RestaurantERP.Web.Models.QuickJoinViewModel
@{
    ViewData["Title"] = "Continue to order";
    Layout = null;
    var returnUrl = Model.ReturnUrl ?? ViewBag.ReturnUrl as string ?? "/Menu";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Continue to order - @AppContent.Get("site.name")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Poppins', sans-serif; }
        :root { --primary: #E63946; --primary-dark: #d32f3f; }
        body { background: #f8f9fa; min-height: 100vh; }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
        .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 0.2rem rgba(230, 57, 70, 0.15); }
        a { color: var(--primary); }
    </style>
</head>
<body>
<div class="container py-5" style="max-width: 440px;">
    <div class="text-center mb-4">
        <a href="/" class="text-decoration-none">
            <h3 class="fw-bold" style="color: var(--primary);">
                <i class="bi @AppContent.Get("site.logo_icon", "bi-fire") me-2"></i>@AppContent.Get("site.name")
            </h3>
        </a>
        <h2 class="fw-bold mt-4 mb-2">Almost there</h2>
        <p class="text-muted mb-0">Name, phone, and email — then continue to your order.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="QuickJoin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" value="@returnUrl" />
                <div asp-validation-summary="All" class="alert alert-danger small" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none");"></div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Your name</label>
                    <input asp-for="FullName" class="form-control form-control-lg" placeholder="@AppContent.Get("placeholder.full_name", "Your name")" autofocus />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Phone number</label>
                    <input asp-for="PhoneNumber" class="form-control form-control-lg" inputmode="tel" placeholder="@AppContent.Get("placeholder.phone", "9876543210")" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Email address <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control form-control-lg" type="email" inputmode="email" autocomplete="email" placeholder="@AppContent.Get("placeholder.email", "you@example.com")" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                    <div class="form-text">Use a real email so you can reset your password later.</div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                    Continue to menu <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <p class="text-center text-muted small mb-0">
                Already have an account?
                <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(returnUrl)" class="fw-semibold text-decoration-none">Sign in</a>
            </p>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="/" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Back to Home</a>
    </div>
</div>
</body>
</html>
