@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<RestaurantERP.Domain.Entities.Category> ?? new();
    var featured = ViewBag.Featured as List<RestaurantERP.Domain.Entities.MenuItem> ?? new();
}

<!-- Hero Section -->
<section class="hero d-flex align-items-center text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="mb-3">@Html.Raw(AppContent.Get("home.hero.title"))</h1>
                <p class="lead mb-4 opacity-75">@AppContent.Get("home.hero.subtitle")</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="@AppContent.Get("home.hero.cta_primary_url", "/Menu")" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-grid me-2"></i>@AppContent.Get("home.hero.cta_primary")
                    </a>
                    <a href="@AppContent.Get("home.hero.cta_secondary_url", "/Home/About")" class="btn btn-outline-light btn-lg px-4">@AppContent.Get("home.hero.cta_secondary")</a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block text-center">
                <img src="@AppContent.Get("home.hero.image")" 
                     alt="@AppContent.Get("site.name")" class="img-fluid rounded-4 shadow-lg" style="max-height: 400px; object-fit: cover;">
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 home-features-section">
    <div class="container">
        <div class="row g-4 text-center">
            @for (var i = 1; i <= 3; i++)
            {
                var featureImage = AppContent.Get($"home.features.{i}.image");
                var featureIcon = AppContent.Get($"home.features.{i}.icon", "bi-star");
                <div class="col-md-4">
                    <div class="p-4 home-feature-card h-100">
                        @if (!string.IsNullOrWhiteSpace(featureImage))
                        {
                            <img src="@featureImage" alt="@AppContent.Get($"home.features.{i}.title")"
                                 class="home-feature-image mb-3" />
                        }
                        else
                        {
                            <div class="home-feature-icon-wrap mb-3">
                                <i class="bi @featureIcon"></i>
                            </div>
                        }
                        <h5 class="fw-bold">@AppContent.Get($"home.features.{i}.title")</h5>
                        <p class="text-muted mb-0">@AppContent.Get($"home.features.{i}.body")</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Styles {
<style>
    .home-features-section {
        background: linear-gradient(180deg, #f7f4ef 0%, #f0ebe3 100%);
    }
    .home-feature-card {
        border-radius: 16px;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .home-feature-card:hover {
        transform: translateY(-3px);
    }
    .home-feature-image {
        width: 88px;
        height: 88px;
        object-fit: cover;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 8px 24px rgba(29, 53, 87, 0.14);
        border: 3px solid #fff;
    }
    .home-feature-icon-wrap {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(145deg, #fff 0%, #f3e9df 100%);
        border: 1px solid rgba(29, 53, 87, 0.08);
        box-shadow: 0 8px 20px rgba(29, 53, 87, 0.08);
        color: var(--secondary, #1D3557);
        font-size: 2rem;
    }
</style>
}

<!-- Categories Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">@AppContent.Get("home.categories.title")</h2>
            <p class="text-muted mt-4">@AppContent.Get("home.categories.subtitle")</p>
        </div>
        <div class="row g-4 justify-content-center">
            @foreach (var cat in categories.Take(6))
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/Menu?category=@cat.Id" class="text-decoration-none">
                        <div class="card text-center p-4 h-100">
                            @if (!string.IsNullOrEmpty(cat.ImageUrl))
                            {
                                <img src="@cat.ImageUrl" alt="@cat.Name"
                                     class="rounded-circle mx-auto mb-3"
                                     style="width: 72px; height: 72px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px;">
                                    <i class="bi bi-egg-fried text-primary fs-4"></i>
                                </div>
                            }
                            <h6 class="fw-bold text-dark mb-0">@cat.Name</h6>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Dishes Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="section-title">@AppContent.Get("home.featured.title")</h2>
                <p class="text-muted mt-4 mb-0">@AppContent.Get("home.featured.subtitle")</p>
            </div>
            <a href="/Menu" class="btn btn-outline-primary d-none d-md-inline-block">View All Menu</a>
        </div>
        <div class="row g-4">
            @foreach (var item in featured.Take(8))
            {
                <partial name="_MenuProductCard" model="item" />
            }
        </div>
        <div class="text-center mt-4 d-md-none">
            <a href="/Menu" class="btn btn-outline-primary">View All Menu</a>
        </div>
    </div>
</section>

<!-- CTA Section -->
@{
    var homeOffer = ViewBag.ActiveOffer as RestaurantERP.Application.DTOs.Orders.CouponDto;
    var ctaTitle = homeOffer?.Title ?? AppContent.Get("home.cta.title");
    var ctaSubtitle = homeOffer?.Subtitle ?? AppContent.Get("home.cta.subtitle");
    var ctaButton = homeOffer?.CtaText ?? "Create Account";
}
<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        @if (!string.IsNullOrEmpty(homeOffer?.BadgeText))
        {
            <span class="badge bg-light text-primary mb-3 px-3 py-2">@homeOffer.BadgeText</span>
        }
        <h2 class="fw-bold mb-3">@ctaTitle</h2>
        <p class="lead mb-4 opacity-75">@ctaSubtitle</p>
        @if (!User.Identity?.IsAuthenticated ?? true)
        {
            <a href="/Account/Register" class="btn btn-light btn-lg px-5">
                <i class="bi bi-person-plus me-2"></i>@ctaButton
            </a>
            @if (homeOffer != null)
            {
                <p class="small mt-3 mb-0 opacity-75">Use code <strong>@homeOffer.Code</strong> at checkout</p>
            }
        }
        else
        {
            <a href="/Menu" class="btn btn-light btn-lg px-5">
                <i class="bi bi-cart-plus me-2"></i>Order Now
            </a>
            @if (homeOffer != null)
            {
                <p class="small mt-3 mb-0 opacity-75">Apply code <strong>@homeOffer.Code</strong> at checkout</p>
            }
        }
    </div>
</section>
