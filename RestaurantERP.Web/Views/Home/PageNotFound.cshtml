@model RestaurantERP.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5 text-center" style="max-width: 560px;">
    <div class="display-1 text-muted fw-bold">@Model.StatusCode</div>
    <h1 class="h3 fw-bold mb-3">@Model.Title</h1>
    <p class="text-muted mb-4">@Model.Message</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-4">Reference: @Model.RequestId</p>
    }
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a href="/" class="btn btn-primary"><i class="bi bi-house me-1"></i> Go Home</a>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
            <i class="bi bi-arrow-left me-1"></i> Go Back
        </button>
    </div>
</div>
