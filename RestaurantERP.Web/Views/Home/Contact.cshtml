@model RestaurantERP.Web.Models.ContactFormViewModel
@{
    ViewData["Title"] = "Contact Us";
    var fb = AppContent.Get("social.facebook");
    var ig = AppContent.Get("social.instagram");
    var tw = AppContent.Get("social.twitter");
    var yt = AppContent.Get("social.youtube");
}

<!-- Hero Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold">@AppContent.Get("contact.title")</h1>
            <p class="lead text-muted">@AppContent.Get("contact.subtitle")</p>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <h3 class="fw-bold mb-4">@AppContent.Get("contact.form.title")</h3>
                <p class="text-muted mb-4">@AppContent.Get("contact.form.intro")</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger @(ViewData.ModelState.ErrorCount > 0 ? "" : "d-none")"></div>
                
                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="@AppContent.Get("placeholder.full_name", "John Doe")" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="@AppContent.Get("placeholder.email", "john@example.com")" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control form-control-lg" placeholder="@AppContent.Get("contact.phone")" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label"></label>
                            <select asp-for="Subject" class="form-select form-select-lg">
                                <option value="">Select a subject</option>
                                <option>General Inquiry</option>
                                <option>Make a Reservation</option>
                                <option>Feedback</option>
                                <option>Catering Services</option>
                                <option>Careers</option>
                            </select>
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="@AppContent.Get("placeholder.contact_message", "Tell us how we can help...")"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="bi bi-send me-2"></i>Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-body p-5">
                        <h4 class="fw-bold mb-4">Contact Information</h4>
                        
                        <div class="d-flex gap-3 mb-4">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-geo-alt text-primary fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Address</h6>
                                <p class="text-muted mb-0">@Html.Raw(AppContent.Get("contact.address"))</p>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-3 mb-4">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-telephone text-primary fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Phone</h6>
                                <p class="text-muted mb-0">@AppContent.Get("contact.phone")<br>@AppContent.Get("contact.phone2")</p>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-3 mb-4">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-envelope text-primary fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Email</h6>
                                <p class="text-muted mb-0">@AppContent.Get("contact.email")<br>@AppContent.Get("contact.email2")</p>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-3 mb-4">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-clock text-primary fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Opening Hours</h6>
                                <p class="text-muted mb-0">
                                    @AppContent.Get("contact.hours.weekday")<br>
                                    @AppContent.Get("contact.hours.weekend")
                                </p>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <h6 class="fw-bold mb-3">Follow Us</h6>
                        <div class="d-flex gap-3">
                            @if (!string.IsNullOrEmpty(fb) && fb != "#") { <a href="@fb" class="btn btn-outline-primary rounded-circle" style="width: 45px; height: 45px;" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a> }
                            @if (!string.IsNullOrEmpty(ig) && ig != "#") { <a href="@ig" class="btn btn-outline-primary rounded-circle" style="width: 45px; height: 45px;" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a> }
                            @if (!string.IsNullOrEmpty(tw) && tw != "#") { <a href="@tw" class="btn btn-outline-primary rounded-circle" style="width: 45px; height: 45px;" target="_blank" rel="noopener"><i class="bi bi-twitter-x"></i></a> }
                            @if (!string.IsNullOrEmpty(yt) && yt != "#") { <a href="@yt" class="btn btn-outline-primary rounded-circle" style="width: 45px; height: 45px;" target="_blank" rel="noopener"><i class="bi bi-youtube"></i></a> }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Find Us</h3>
        </div>
        <div class="rounded-4 overflow-hidden shadow">
            <iframe 
                src="@AppContent.Get("contact.map.embed_url")" 
                width="100%" 
                height="400" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy">
            </iframe>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
