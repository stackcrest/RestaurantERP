@model List<RestaurantERP.Domain.Entities.BlogPost>
@{
    ViewData["Title"] = "Blog";
    var tag = ViewBag.Tag as string;
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold">@(string.IsNullOrEmpty(tag) ? AppContent.Get("blog.hero.title") : $"Posts tagged: {tag}")</h1>
            <p class="text-muted lead mb-0">@AppContent.Get("blog.hero.subtitle")</p>
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var post in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="card h-100 border-0 shadow-sm blog-card">
                            <a href="/Blog/Post/@post.Slug" class="text-decoration-none text-dark">
                                <img src="@(post.FeaturedImageUrl ?? AppContent.Get("blog.post.fallback_image"))"
                                     class="card-img-top" alt="@post.Title" style="height: 200px; object-fit: cover;" />
                                <div class="card-body">
                                    <div class="small text-muted mb-2">
                                        @(post.PublishedAt?.ToLocalTime().ToString("MMMM dd, yyyy") ?? post.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy"))
                                        · @post.AuthorName
                                    </div>
                                    <h5 class="fw-bold">@post.Title</h5>
                                    <p class="text-muted small mb-3">@(post.Summary ?? "")</p>
                                    @if (!string.IsNullOrEmpty(post.Tags))
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var t in post.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3))
                                            {
                                                <span class="badge bg-light text-dark">@t</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-white border-0 pt-0">
                                    <span class="text-primary fw-medium small">Read more <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </a>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-text display-4 text-muted"></i>
                <p class="text-muted mt-3 mb-0">No blog posts published yet. Check back soon!</p>
            </div>
        }
    </div>
</section>

@section Styles {
<style>
    .blog-card { transition: transform 0.2s; }
    .blog-card:hover { transform: translateY(-4px); }
</style>
}
