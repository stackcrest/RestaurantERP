@model List<RestaurantERP.Domain.Entities.Order>
@using RestaurantERP.Domain.Enums
@{
    ViewData["Title"] = "My Orders";
}

<div class="p-3">
    <h1 class="h5 fw-bold mb-3">My Orders</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        ViewBag.EmptyIcon = "bi-receipt";
        ViewBag.EmptyTitle = "No orders yet";
        ViewBag.EmptyMessage = "No items — browse menu to place your first order.";
        ViewBag.EmptyCtaText = "Browse menu";
        ViewBag.EmptyCtaUrl = "/Menu";
        <partial name="_EmptyState" />
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="card">
                    <div class="card-body p-3">
                        <a href="/Orders/Details/@order.Id" class="text-decoration-none text-reset">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@order.OrderNumber</h6>
                                    <small class="text-muted">
                                        @order.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
                                    </small>
                                </div>
                                <partial name="_OrderStatusBadge" model="order.Status" />
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">@order.Items.Count items • @order.OrderType</span>
                                <span class="fw-bold text-primary">₹@order.TotalAmount.ToString("N0")</span>
                            </div>
                        </a>
                        @if (order.Status == OrderStatus.Placed)
                        {
                            <form asp-action="Cancel" method="post" class="mt-3" onsubmit="return confirm('Cancel this order?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="returnTo" value="index" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">Cancel order</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
