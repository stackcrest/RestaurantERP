@model List<RestaurantERP.Domain.Entities.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="p-3">
    <h1 class="h5 fw-bold mb-3">My Orders</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt display-1 text-muted d-block mb-3"></i>
            <h5>No orders yet</h5>
            <p class="text-muted small">Your order history will appear here</p>
            <a href="/Menu" class="btn btn-primary mt-2">Start Ordering</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <a href="/Orders/Details/@order.Id" class="text-decoration-none">
                    <div class="card">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@order.OrderNumber</h6>
                                    <small class="text-muted">
                                        @order.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
                                    </small>
                                </div>
                                <partial name="_OrderStatusBadge" model="order.Status" />
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">@order.Items.Count items • @order.OrderType</span>
                                <span class="fw-bold text-primary">₹@order.TotalAmount.ToString("N0")</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
