@using Microsoft.AspNetCore.Identity
@using RestaurantERP.Application.DTOs.Orders
@inject IWhatsAppIntegrationService WhatsApp
@inject SignInManager<RestaurantERP.Domain.Entities.ApplicationUser> SignInManager
@inject UserManager<RestaurantERP.Domain.Entities.ApplicationUser> UserManager
@{
    var theme = ViewBag.SiteTheme as ThemeSetting;
    var mainNav = ViewBag.MainNav as List<NavigationMenuItem> ?? new();
    var mainNavChildren = ViewBag.MainNavChildren as Dictionary<Guid, List<NavigationMenuItem>> ?? new();
    var footerNav = ViewBag.FooterNav as List<NavigationMenuItem> ?? new();
    var activeOffer = ViewBag.ActiveOffer as CouponDto;
    var siteName = AppContent.Get("site.name", "Restaurant ERP");
    var logoIcon = AppContent.Get("site.logo_icon", "bi-fire");
    var primary = theme?.PrimaryColor ?? "#E63946";
    var secondary = theme?.SecondaryColor ?? "#1D3557";
    var accent = theme?.AccentColor ?? "#F4A261";
    var background = theme?.BackgroundColor ?? "#FFFFFF";
    var surface = theme?.SurfaceColor ?? "#F8F9FA";
    var textPrimary = theme?.TextPrimary ?? "#212529";
    var textSecondary = theme?.TextSecondary ?? "#6C757D";
    var fontBody = string.IsNullOrWhiteSpace(theme?.FontFamily) ? "'Source Sans 3', system-ui, sans-serif" : theme!.FontFamily;
    var fontHeading = string.IsNullOrWhiteSpace(theme?.HeadingFontFamily) ? "'Cormorant Garamond', Georgia, serif" : theme!.HeadingFontFamily;
    var radius = string.IsNullOrWhiteSpace(theme?.BorderRadius) ? "12px" : theme!.BorderRadius;
    var buttonRadius = ThemeUiCatalog.ResolveButtonRadius(theme?.ButtonStyle, radius);
    var primaryDark = ThemeUiCatalog.DarkenHex(primary);
    var (shadowSm, shadowMd, shadowLg) = ThemeUiCatalog.ResolveShadows(theme?.ShadowIntensity);
    var colorGrade = ThemeUiCatalog.ResolveColorGradeFilter(theme?.ColorGrade);
    var colorGradeOverlay = ThemeUiCatalog.ResolveColorGradeOverlay(theme?.ColorGrade);
    var colorGradeBlend = ThemeUiCatalog.ResolveColorGradeBlend(theme?.ColorGrade);
    var fontsHref = ThemeUiCatalog.ResolveGoogleFontsHref(fontBody, fontHeading);
    var motion = (theme?.MotionStyle ?? "subtle").ToLowerInvariant();
    var animOn = theme?.EnableAnimations != false && motion != "none";
    var lift = motion switch { "lively" => "8px", "smooth" => "5px", _ => "3px" };
    var duration = motion switch { "lively" => ".18s", "smooth" => ".35s", _ => ".25s" };
    var heroStyle = (theme?.HeroStyle ?? "gradient").ToLowerInvariant();
    var heroBg = heroStyle switch
    {
        "solid" => secondary,
        "soft-glow" => $"radial-gradient(circle at 28% 18%, {accent}66, transparent 42%), linear-gradient(160deg, {secondary}, {primary})",
        _ => $"linear-gradient(135deg, {secondary} 0%, {ThemeUiCatalog.DarkenHex(secondary, 1.15)} 55%, {primary} 140%)"
    };
    if (theme?.DarkMode == true && background.Equals("#FFFFFF", StringComparison.OrdinalIgnoreCase))
    {
        background = "#0F172A";
        surface = "#1E293B";
        textPrimary = "#F8FAFC";
        textSecondary = "#94A3B8";
    }
}
<!DOCTYPE html>
<html lang="en" class="@(animOn ? "theme-anim-on" : "theme-anim-off")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@AppContent.Get("seo.default_description")" />
    <title>@ViewData["Title"] - @AppContent.Get("seo.title_suffix", siteName)</title>
    @if (!string.IsNullOrEmpty(theme?.FaviconUrl))
    {
        <link rel="icon" href="@(theme.FaviconUrl)?v=@(theme.Version)" />
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="@fontsHref" rel="stylesheet" />
    <link href="~/css/whatsapp-widget.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/site-nav.css" asp-append-version="true" rel="stylesheet" />
    <style>
        :root {
            --primary: @primary;
            --primary-dark: @primaryDark;
            --secondary: @secondary;
            --accent: @accent;
            --light: @surface;
            --dark: @textPrimary;
            --bg: @background;
            --surface: @surface;
            --text: @textPrimary;
            --text-muted: @textSecondary;
            --radius: @radius;
            --btn-radius: @buttonRadius;
            --font-body: @Html.Raw(fontBody);
            --font-heading: @Html.Raw(fontHeading);
            --shadow-sm: @shadowSm;
            --shadow-md: @shadowMd;
            --shadow-lg: @shadowLg;
            --color-grade: @colorGrade;
            --color-grade-overlay: @colorGradeOverlay;
            --color-grade-blend: @colorGradeBlend;
            --motion-lift: @lift;
            --motion-duration: @duration;
            --hero-bg: @heroBg;
        }

        body {
            font-family: var(--font-body);
            background: var(--bg);
            color: var(--text);
        }
        /* Color grade via overlay — avoids filter on body (breaks position:fixed) */
        body::after {
            content: '';
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 10000;
            background: var(--color-grade-overlay);
            mix-blend-mode: var(--color-grade-blend);
        }
        .brand-font,
        .hero h1,
        .section-title,
        .site-navbar .navbar-brand {
            font-family: var(--font-heading);
        }
        .text-muted { color: var(--text-muted) !important; }

        /* Buttons */
        .btn-primary { background: var(--primary); border-color: var(--primary); border-radius: var(--btn-radius); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
        .btn-outline-primary { color: var(--primary); border-color: var(--primary); border-radius: var(--btn-radius); }
        .btn-outline-primary:hover { background: var(--primary); border-color: var(--primary); }
        .btn-light, .btn-outline-light { border-radius: var(--btn-radius); }
        .text-primary { color: var(--primary) !important; }
        .bg-primary { background: var(--primary) !important; }
        
        /* Hero Section */
        .hero { background: var(--hero-bg); min-height: 500px; }
        .hero h1 { font-size: 3rem; font-weight: 700; }
        
        /* Cards */
        .card {
            border: none;
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            background: var(--surface);
            transition: transform var(--motion-duration), box-shadow var(--motion-duration);
        }
        html.theme-anim-on .card:hover {
            transform: translateY(calc(var(--motion-lift) * -1));
            box-shadow: var(--shadow-lg);
        }
        html.theme-anim-off .card:hover { transform: none; }
        
        /* Menu Item Card */
        .menu-card img { height: 200px; object-fit: cover; border-radius: var(--radius) var(--radius) 0 0; }
        .menu-card .card-body { padding: 1.25rem; }
        
        /* Veg/Non-veg badges */
        .veg-badge { width: 18px; height: 18px; border: 2px solid #22c55e; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; }
        .veg-badge::before { content: ''; width: 10px; height: 10px; background: #22c55e; border-radius: 50%; }
        .nonveg-badge { width: 18px; height: 18px; border: 2px solid #ef4444; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; }
        .nonveg-badge::before { content: ''; width: 10px; height: 10px; background: #ef4444; border-radius: 50%; }
        
        /* Section styling */
        .section-title { font-weight: 700; position: relative; display: inline-block; }
        .section-title::after { content: ''; position: absolute; bottom: -8px; left: 0; width: 60px; height: 4px; background: var(--primary); border-radius: 2px; }
        
        /* Footer */
        footer { background: var(--secondary); }
        footer a { color: rgba(255,255,255,0.7); text-decoration: none; }
        footer a:hover { color: #fff; }
        
        /* Floating Cart */
        .cart-floating { position: fixed; bottom: 30px; right: 30px; z-index: 1000; }
        .cart-floating .btn { padding: 1rem 1.5rem; border-radius: 50px; box-shadow: 0 4px 20px rgba(230, 57, 70, 0.4); }
        
        /* Blinkit-style cart controls */
        .blinkit-add-btn {
            background: #fff;
            border: 1.5px solid var(--primary);
            color: var(--primary);
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.35rem 1.25rem;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            min-height: 36px;
            min-width: 72px;
        }
        .blinkit-add-btn:hover { background: #fff5f5; color: var(--primary-dark); border-color: var(--primary-dark); }
        .blinkit-qty-stepper {
            display: flex;
            align-items: center;
            background: var(--primary);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(230,57,70,0.35);
            min-height: 36px;
        }
        .blinkit-qty-stepper .btn {
            background: transparent;
            border: none;
            color: #fff;
            font-weight: 700;
            font-size: 1.1rem;
            padding: 0.25rem 0.65rem;
            line-height: 1;
            min-width: 40px;
            min-height: 36px;
        }
        .blinkit-qty-stepper .btn:hover { background: rgba(255,255,255,0.15); color: #fff; }
        .blinkit-qty-stepper .qty-value {
            color: #fff;
            font-weight: 700;
            min-width: 1.5rem;
            text-align: center;
            font-size: 0.9rem;
        }
        .menu-card { overflow: hidden; }

        /* Mobile floating cart bar (Blinkit style) */
        #floatingCartBar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: var(--primary);
            color: #fff;
            padding: 0.9rem 1.25rem;
            padding-bottom: calc(0.9rem + env(safe-area-inset-bottom, 0px));
            box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
        }
        #floatingCartBar a { color: #fff; text-decoration: none; }
        body.has-sticky-cart { padding-bottom: 4.5rem; }
        body.hide-sticky-cart #floatingCartBar,
        body.hide-sticky-cart #desktopCartWrapper { display: none !important; }

        .option-chip {
            border: 1.5px solid #dee2e6;
            border-radius: 12px;
            padding: 0.85rem 1rem;
            cursor: pointer;
            transition: border-color .15s, background .15s;
            user-select: none;
        }
        .option-chip.active, .option-chip:has(input:checked) {
            border-color: var(--primary);
            background: rgba(230, 57, 70, 0.06);
        }
        .option-chip input { display: none; }

        /* Zomato-style Half/Full customizer sheet */
        #menuOptionsSheet.menu-customizer {
            height: auto;
            max-height: 88vh;
            background: #1a1a1a;
            color: #f5f5f5;
            border-radius: 20px 20px 0 0;
        }
        #menuOptionsSheet.menu-customizer .offcanvas-header {
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 1rem 1.15rem;
        }
        #menuOptionsSheet.menu-customizer .btn-close {
            filter: invert(1) grayscale(100%);
            opacity: 0.85;
        }
        .menu-customizer-thumb {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            object-fit: cover;
            background: #333;
            flex-shrink: 0;
        }
        .menu-customizer-body {
            padding: 0.75rem 1.15rem 1rem;
            overflow-y: auto;
            max-height: calc(88vh - 160px);
        }
        .menu-customizer-section {
            background: #242424;
            border-radius: 14px;
            padding: 1rem;
            margin-bottom: 0.85rem;
        }
        .menu-customizer-section h6 {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 0.15rem;
            color: #fff;
            text-transform: none;
        }
        .menu-customizer-hint {
            font-size: 0.75rem;
            color: #9a9a9a;
            margin-bottom: 0.85rem;
        }
        .menu-customizer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.7rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            cursor: pointer;
            margin: 0;
        }
        .menu-customizer-row:last-child { border-bottom: 0; padding-bottom: 0; }
        .menu-customizer-row:first-of-type { padding-top: 0; }
        .menu-customizer-row .row-label { font-size: 0.95rem; color: #eee; }
        .menu-customizer-row .row-sub { font-size: 0.75rem; color: #8e8e8e; }
        .menu-customizer-row .row-price { font-size: 0.95rem; color: #ddd; margin-right: 0.65rem; white-space: nowrap; }
        .menu-customizer-row input[type="radio"],
        .menu-customizer-row input[type="checkbox"] {
            width: 1.15rem;
            height: 1.15rem;
            accent-color: var(--primary);
            flex-shrink: 0;
        }
        .menu-customizer-footer {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 1.15rem;
            padding-bottom: calc(0.85rem + env(safe-area-inset-bottom, 0px));
            border-top: 1px solid rgba(255,255,255,0.08);
            background: #141414;
        }
        .menu-customizer-qty {
            display: flex;
            align-items: center;
            background: #2a2a2a;
            border-radius: 10px;
            overflow: hidden;
            min-height: 48px;
        }
        .menu-customizer-qty button {
            background: transparent;
            border: 0;
            color: #fff;
            width: 42px;
            height: 48px;
            font-size: 1.25rem;
            font-weight: 700;
        }
        .menu-customizer-qty .qty-val {
            min-width: 28px;
            text-align: center;
            font-weight: 700;
            color: #fff;
        }
        .menu-customizer-add {
            flex: 1;
            background: var(--primary) !important;
            border: none !important;
            border-radius: 12px !important;
            min-height: 48px;
            font-weight: 700 !important;
            font-size: 1rem !important;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .hero h1 { font-size: 2rem; }
            .hero { min-height: 400px; }
            .blinkit-add-btn {
                font-size: 0.95rem;
                padding: 0.55rem 1.35rem;
                min-height: 44px;
                min-width: 88px;
            }
            .blinkit-qty-stepper { min-height: 44px; }
            .blinkit-qty-stepper .btn {
                min-width: 44px;
                min-height: 44px;
                font-size: 1.35rem;
                padding: 0.35rem 0.75rem;
            }
            .blinkit-qty-stepper .qty-value { font-size: 1rem; min-width: 1.75rem; }
            .menu-card .card-img-top { height: 160px !important; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@await Html.PartialAsync("_NotificationBar")

    <div class="site-topbar py-2 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a href="tel:@AppContent.Get("footer.phone")"><i class="bi bi-telephone me-1"></i>@AppContent.Get("footer.phone")</a>
                <span class="opacity-50">|</span>
                <a href="mailto:@AppContent.Get("footer.email")"><i class="bi bi-envelope me-1"></i>@AppContent.Get("footer.email")</a>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (activeOffer != null)
                {
                    <span class="offer-chip">@(activeOffer.BadgeText ?? $"{activeOffer.DiscountPercentage:0}% OFF")</span>
                    <span>@activeOffer.Subtitle · Code <strong>@activeOffer.Code</strong></span>
                }
                else
                {
                    <span>@AppContent.Get("site.tagline", "Delicious food, delivered fast")</span>
                }
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg sticky-top site-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                @if (!string.IsNullOrEmpty(theme?.LogoUrl))
                {
                    <img src="@(theme.LogoUrl)?v=@(theme.Version)" alt="@siteName" />
                }
                else
                {
                    <i class="bi @logoIcon" style="color: var(--primary);"></i>
                }
                @siteName
            </a>
            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#siteNavOffcanvas"
                    aria-controls="siteNavOffcanvas" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="offcanvas-lg offcanvas-end site-nav-offcanvas" tabindex="-1" id="siteNavOffcanvas" aria-labelledby="siteNavOffcanvasLabel">
                <div class="offcanvas-header border-bottom">
                    <h5 class="offcanvas-title fw-bold mb-0" id="siteNavOffcanvasLabel">Menu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#siteNavOffcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                <ul class="navbar-nav mx-lg-auto align-items-lg-center">
                    @foreach (var navItem in mainNav)
                    {
                        var isActive = navItem.Url == "/"
                            ? ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index"
                            : Context.Request.Path.Value?.StartsWith(navItem.Url ?? "", StringComparison.OrdinalIgnoreCase) == true;
                        var children = mainNavChildren.GetValueOrDefault(navItem.Id);

                        if (children != null && children.Count > 0)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isActive ? "active" : "")" href="@(string.IsNullOrEmpty(navItem.Url) ? "#" : navItem.Url)" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                    @if (!string.IsNullOrEmpty(navItem.Icon)) { <i class="bi @navItem.Icon me-1"></i> }
                                    @navItem.Label
                                </a>
                                <ul class="dropdown-menu">
                                    @if (!string.IsNullOrEmpty(navItem.Url))
                                    {
                                        <li><a class="dropdown-item" href="@navItem.Url">@navItem.Label</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    @foreach (var child in children)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="@child.Url" @(child.OpenInNewTab ? "target=\"_blank\" rel=\"noopener\"" : "")>
                                                @if (!string.IsNullOrEmpty(child.Icon)) { <i class="bi @child.Icon me-2"></i> }
                                                @child.Label
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isActive ? "active" : "")" href="@(navItem.Url ?? "#")" @(navItem.OpenInNewTab ? "target=\"_blank\" rel=\"noopener\"" : "")>
                                    @if (!string.IsNullOrEmpty(navItem.Icon)) { <i class="bi @navItem.Icon me-1"></i> }
                                    @navItem.Label
                                </a>
                            </li>
                        }
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center site-nav-actions">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
                        var isStaff = roles.Contains("Admin") || roles.Contains("SuperAdmin");
                        var waSupportUrl = !isStaff && WhatsApp.IsEnabled()
                            ? WhatsApp.GetSupportChatUrl(user?.FullName, user?.Email, siteName)
                            : null;
                        @if (!isStaff)
                        {
                        @if (!string.IsNullOrEmpty(waSupportUrl))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-success" href="@waSupportUrl" target="_blank" rel="noopener noreferrer" title="WhatsApp Support">
                                <i class="bi bi-whatsapp me-1"></i><span class="d-lg-none">WhatsApp</span>
                            </a>
                        </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" href="/Cart">
                                <i class="bi bi-bag me-1"></i><span class="d-lg-none">Cart</span>
                                <span class="badge bg-primary rounded-pill @(ViewBag.CartCount != null && (int)ViewBag.CartCount > 0 ? "" : "d-none")" id="navCartBadge">@(ViewBag.CartCount ?? 0)</span>
                            </a>
                        </li>
                        <li class="nav-item d-none d-lg-block">
                            <a class="nav-link" href="/Orders">Orders</a>
                        </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                @if (!string.IsNullOrEmpty(user?.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" alt="@user.FullName" class="rounded-circle nav-avatar" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                <span class="d-lg-inline text-uppercase site-nav-user-label" style="font-size:0.8rem;">@(user?.FullName ?? "Account")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                @if (!isStaff)
                                {
                                    <li><a class="dropdown-item d-lg-none" href="/Orders"><i class="bi bi-receipt me-2"></i>My Orders</a></li>
                                }
                                @if (roles.Contains("Admin") || roles.Contains("SuperAdmin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Admin"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a></li>
                                }
                                @if (roles.Contains("SuperAdmin"))
                                {
                                    <li><a class="dropdown-item" href="/SuperAdmin"><i class="bi bi-shield-check me-2"></i>SuperAdmin</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary ms-lg-2" href="/Account/QuickJoin">Order now</a>
                        </li>
                    }
                </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Floating Cart Bar (sticky everywhere except cart/checkout) -->
    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var act = ViewContext.RouteData.Values["action"]?.ToString();
        var hideStickyCart = string.Equals(ctrl, "Cart", StringComparison.OrdinalIgnoreCase)
            || (string.Equals(ctrl, "Orders", StringComparison.OrdinalIgnoreCase)
                && string.Equals(act, "Checkout", StringComparison.OrdinalIgnoreCase));
    }
    @if (SignInManager.IsSignedIn(User))
    {
        var layoutUser = await UserManager.GetUserAsync(User);
        var layoutRoles = layoutUser != null ? await UserManager.GetRolesAsync(layoutUser) : new List<string>();
        var layoutIsStaff = layoutRoles.Contains("Admin") || layoutRoles.Contains("SuperAdmin");
        if (!layoutIsStaff)
        {
        var showCart = ViewBag.CartCount != null && ViewBag.CartCount > 0;
        if (hideStickyCart)
        {
            <script>document.body.classList.add('hide-sticky-cart');</script>
        }
        else if (showCart)
        {
            <script>document.body.classList.add('has-sticky-cart');</script>
        }
        <div id="floatingCartBar" class="d-md-none @(showCart && !hideStickyCart ? "" : "d-none")" data-hide-on-cart="@(hideStickyCart ? "1" : "0")">
            <a href="/Cart" class="d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bag-check me-2"></i><span id="floatingCartCount">@(ViewBag.CartCount ?? 0)</span> items</span>
                <span class="fw-bold">View cart · <span id="floatingCartTotal">₹@(ViewBag.CartTotal?.ToString("N0") ?? "0")</span> <i class="bi bi-chevron-right"></i></span>
            </a>
        </div>
        <div id="desktopCartWrapper" class="cart-floating @(showCart && !hideStickyCart ? "d-none d-md-block" : "d-none")">
            <a href="/Cart" class="btn btn-primary" id="desktopCartBtn">
                <i class="bi bi-bag-check me-2"></i>View cart · <span id="desktopCartCount">@(ViewBag.CartCount ?? 0)</span> · <span id="desktopCartTotal">₹@(ViewBag.CartTotal?.ToString("N0") ?? "0")</span>
            </a>
        </div>
        }
    }

    <!-- Customize sheet: Half/Full + add-ons (Zomato-style) -->
    <div class="offcanvas offcanvas-bottom menu-customizer" tabindex="-1" id="menuOptionsSheet" aria-labelledby="menuOptionsTitle">
        <div class="offcanvas-header">
            <div class="d-flex align-items-center gap-3 flex-grow-1 pe-2">
                <img src="" alt="" class="menu-customizer-thumb d-none" id="menuOptionsThumb" />
                <div class="min-w-0">
                    <h5 class="offcanvas-title fw-bold mb-0 text-truncate" id="menuOptionsTitle">Customize</h5>
                    <small class="text-secondary" id="menuOptionsPrice"></small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="menu-customizer-body" id="menuOptionsBody">
            <div class="text-center py-4 text-secondary">Loading…</div>
        </div>
        <div class="menu-customizer-footer">
            <div class="menu-customizer-qty">
                <button type="button" id="sheetQtyMinus" aria-label="Decrease">−</button>
                <span class="qty-val" id="sheetQtyValue">1</span>
                <button type="button" id="sheetQtyPlus" aria-label="Increase">+</button>
            </div>
            <input type="hidden" id="sheetQty" value="1" />
            <button type="button" class="btn btn-primary menu-customizer-add" id="menuOptionsAddBtn" disabled>
                Add item
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_WhatsAppWidget")

    <!-- Footer -->
    <footer class="text-white py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3">
                        @if (!string.IsNullOrEmpty(theme?.LogoUrl))
                        {
                            <img src="@(theme.LogoUrl)?v=@(theme.Version)" alt="@siteName" height="28" class="me-2" />
                        }
                        else
                        {
                            <i class="bi @logoIcon me-2"></i>
                        }
                        @siteName
                    </h5>
                    <p class="text-white-50">@AppContent.Get("footer.tagline")</p>
                    <div class="d-flex gap-3 mt-3">
                        @{
                            var fb = AppContent.Get("social.facebook");
                            var ig = AppContent.Get("social.instagram");
                            var tw = AppContent.Get("social.twitter");
                        }
                        @if (!string.IsNullOrEmpty(fb) && fb != "#") { <a href="@fb" class="fs-5" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a> }
                        @if (!string.IsNullOrEmpty(ig) && ig != "#") { <a href="@ig" class="fs-5" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a> }
                        @if (!string.IsNullOrEmpty(tw) && tw != "#") { <a href="@tw" class="fs-5" target="_blank" rel="noopener"><i class="bi bi-twitter-x"></i></a> }
                    </div>
                </div>
                <div class="col-lg-2 col-md-4">
                    <h6 class="fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled">
                        @foreach (var link in footerNav)
                        {
                            <li class="mb-2"><a href="@link.Url" @(link.OpenInNewTab ? "target=\"_blank\" rel=\"noopener\"" : "")>@link.Label</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h6 class="fw-bold mb-3">Opening Hours</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2">@AppContent.Get("footer.hours.weekday")</li>
                        <li class="mb-2">@AppContent.Get("footer.hours.saturday")</li>
                        <li class="mb-2">@AppContent.Get("footer.hours.sunday")</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h6 class="fw-bold mb-3">Contact Us</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i>@AppContent.Get("footer.address")</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2"></i>@AppContent.Get("footer.phone")</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i>@AppContent.Get("footer.email")</li>
                    </ul>
                </div>
            </div>
            <hr class="my-4 opacity-25">
            <div class="text-center text-white-50">
                <small>&copy; @DateTime.Now.Year @siteName. @AppContent.Get("footer.copyright")</small>
            </div>        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/notification-bar.js" asp-append-version="true"></script>
    <script>
        // Close mobile nav after clicking a real link (Menu, Blog, Contact, etc.)
        document.getElementById('siteNavOffcanvas')?.addEventListener('click', (e) => {
            const link = e.target.closest('a[href]');
            if (!link) return;
            const href = link.getAttribute('href') || '';
            if (!href || href === '#' || href.startsWith('javascript:')) return;
            if (window.matchMedia('(min-width: 992px)').matches) return;
            const panel = document.getElementById('siteNavOffcanvas');
            const instance = bootstrap.Offcanvas.getInstance(panel);
            instance?.hide();
        });
        // Safety: remove leftover backdrops that block page clicks
        document.getElementById('siteNavOffcanvas')?.addEventListener('hidden.bs.offcanvas', () => {
            document.querySelectorAll('.offcanvas-backdrop').forEach((el) => el.remove());
            document.body.classList.remove('overflow-hidden');
            document.body.style.removeProperty('padding-right');
        });
    </script>
    @if (SignInManager.IsSignedIn(User))
    {
        var scriptUser = await UserManager.GetUserAsync(User);
        var scriptRoles = scriptUser != null ? await UserManager.GetRolesAsync(scriptUser) : new List<string>();
        var scriptIsStaff = scriptRoles.Contains("Admin") || scriptRoles.Contains("SuperAdmin");
        if (!scriptIsStaff)
        {
            <script src="~/js/blinkit-cart.js" asp-append-version="true"></script>
        }
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
