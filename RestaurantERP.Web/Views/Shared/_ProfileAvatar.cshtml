@model RestaurantERP.Domain.Entities.ApplicationUser
@{
    var initial = !string.IsNullOrEmpty(Model.FullName)
        ? Model.FullName.Trim()[0].ToString().ToUpperInvariant()
        : "?";
    var size = ViewData["AvatarSize"] as int? ?? 64;
    var cssClass = ViewData["AvatarClass"] as string ?? "";
}

@if (!string.IsNullOrEmpty(Model.AvatarUrl))
{
    <img src="@Model.AvatarUrl" alt="@Model.FullName"
         class="rounded-circle object-fit-cover @cssClass"
         style="width:@(size)px;height:@(size)px;" />
}
else
{
    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold @cssClass"
         style="width:@(size)px;height:@(size)px;background:linear-gradient(135deg,#E63946,#1D3557);font-size:@(size / 2.5)px;">
        @initial
    </div>
}
