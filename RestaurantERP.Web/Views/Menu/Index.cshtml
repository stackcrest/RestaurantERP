@model List<RestaurantERP.Domain.Entities.MenuItem>
@{
    ViewData["Title"] = AppContent.Get("menu.hero.title", "Our Menu");
    var categories = ViewBag.Categories as List<RestaurantERP.Domain.Entities.Category> ?? new();
    var selectedCategory = ViewBag.SelectedCategory as Guid?;
    var search = ViewBag.Search as string;
    var vegOnly = (bool)ViewBag.VegOnly;
}

<!-- Hero Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center">
            <h1 class="fw-bold mb-3">@AppContent.Get("menu.hero.title")</h1>
            <p class="lead text-muted">@AppContent.Get("menu.hero.subtitle")</p>
        </div>
    </div>
</section>

<!-- Menu Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Sidebar Filters -->
            <div class="col-lg-3">
                <div class="card sticky-lg-top" style="top: 80px;">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Search</h5>
                        <form method="get" class="mb-4">
                            <div class="input-group">
                                <input type="text" name="search" value="@search" class="form-control" placeholder="Search dishes...">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            @if (selectedCategory.HasValue)
                            {
                                <input type="hidden" name="category" value="@selectedCategory" />
                            }
                        </form>
                        
                        <h5 class="fw-bold mb-3">Categories</h5>
                        <div class="list-group list-group-flush mb-4">
                            <a href="/Menu@(vegOnly ? "?veg=true" : "")" 
                               class="list-group-item list-group-item-action @(selectedCategory == null ? "active" : "")">
                                All Categories
                            </a>
                            @foreach (var cat in categories)
                            {
                                <a href="/Menu?category=@cat.Id@(vegOnly ? "&veg=true" : "")" 
                                   class="list-group-item list-group-item-action @(selectedCategory == cat.Id ? "active" : "")">
                                    @cat.Name
                                </a>
                            }
                        </div>
                        
                        <h5 class="fw-bold mb-3">Dietary</h5>
                        <a href="/Menu?@(selectedCategory != null ? $"category={selectedCategory}&" : "")veg=@(!vegOnly)@(!string.IsNullOrEmpty(search) ? $"&search={search}" : "")" 
                           class="btn @(vegOnly ? "btn-success" : "btn-outline-success") w-100">
                            <i class="bi bi-leaf me-2"></i>Veg Only
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Menu Items -->
            <div class="col-lg-9">
                @if (!string.IsNullOrEmpty(search))
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center">
                        <span>Showing results for "<strong>@search</strong>"</span>
                        <a href="/Menu@(selectedCategory != null ? $"?category={selectedCategory}" : "")" class="btn btn-sm btn-outline-primary">Clear</a>
                    </div>
                }
                
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted d-block mb-3"></i>
                        <h4>No dishes found</h4>
                        <p class="text-muted">Try adjusting your search or filters</p>
                        <a href="/Menu" class="btn btn-primary mt-2">View All Menu</a>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var item in Model)
                        {
                            <partial name="_MenuProductCard" model="item" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
}
