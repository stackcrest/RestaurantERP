@model RestaurantERP.Domain.Entities.MenuItem
@using RestaurantERP.Application.DTOs.Orders
@{
    ViewData["Title"] = Model.Name;
    var reviews = ViewBag.Reviews as List<ReviewDto> ?? new();
    var isLiked = ViewBag.IsLiked as bool? ?? false;
    var filledStars = (int)Math.Round(Model.AverageRating);
    if (filledStars < 0) filledStars = 0;
    if (filledStars > 5) filledStars = 5;
}

<section class="py-5">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="/Menu" class="text-decoration-none">Menu</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>
        
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="card border-0 overflow-hidden">
                    <img src="@(Model.ImageUrl ?? AppContent.Get("menu.item.fallback_image"))" 
                         class="img-fluid rounded-4" style="width: 100%; height: 400px; object-fit: cover;" alt="@Model.Name">
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="@(Model.IsVeg ? "veg-badge" : "nonveg-badge")"></span>
                    <span class="badge bg-light text-dark">@Model.Category.Name</span>
                    @if (Model.IsFeatured)
                    {
                        <span class="badge bg-warning text-dark">Featured</span>
                    }
                </div>
                
                <h1 class="fw-bold mb-3">@Model.Name</h1>
                
                <div class="d-flex align-items-center gap-4 mb-4 flex-wrap">
                    <span class="h3 fw-bold text-primary mb-0">₹@Model.BasePrice</span>
                    <span class="text-warning">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= filledStars ? "bi-star-fill" : "bi-star")"></i>
                        }
                        <span class="text-dark ms-1">@Model.AverageRating.ToString("N1")</span>
                        <span class="text-muted">(@Model.ReviewCount reviews)</span>
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="ToggleLike" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="menuItemId" value="@Model.Id" />
                            <button type="submit" class="btn @(isLiked ? "btn-danger" : "btn-outline-danger")">
                                <i class="bi @(isLiked ? "bi-heart-fill" : "bi-heart") me-1"></i>
                                @(isLiked ? "Liked" : "Like")
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login?returnUrl=/Menu/Details/@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-heart me-1"></i>Like
                        </a>
                    }
                    <button type="button" class="btn btn-outline-secondary" onclick="shareMenuItem()">
                        <i class="bi bi-share me-1"></i>Share
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="copyMenuLink()">
                        <i class="bi bi-link-45deg me-1"></i>Copy link
                    </button>
                </div>
                
                <p class="text-muted mb-4">@Model.Description</p>
                
                <div class="d-flex gap-4 mb-4">
                    <div>
                        <i class="bi bi-clock text-primary me-2"></i>
                        <span>@Model.PreparationTimeMinutes min prep time</span>
                    </div>
                    <div>
                        <i class="bi bi-fire text-primary me-2"></i>
                        <span>@Model.SpiceLevel spice level</span>
                    </div>
                </div>
                
                <hr class="my-4">
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var canPlaceOrders = ViewBag.CanPlaceOrders as bool? ?? true;
                    if (canPlaceOrders)
                    {
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="menuItemId" value="@Model.Id" />

                        @if (Model.Variants.Any())
                        {
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">Select Size</h6>
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (var variant in Model.Variants)
                                    {
                                        <label class="btn btn-outline-primary">
                                            <input type="radio" name="variantId" value="@variant.Id" class="d-none" 
                                                   @(variant.IsDefault ? "checked" : "")>
                                            @variant.Name (+₹@variant.PriceAdjustment)
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.MenuItemAddOns.Any())
                        {
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">Add Extras</h6>
                                @foreach (var ma in Model.MenuItemAddOns)
                                {
                                    <label class="d-flex align-items-center justify-content-between p-3 border rounded-3 mb-2 cursor-pointer">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" name="addOnIds" value="@ma.AddOn.Id" class="form-check-input">
                                            <span>@ma.AddOn.Name</span>
                                        </div>
                                        <span class="text-muted">+₹@ma.AddOn.Price</span>
                                    </label>
                                }
                            </div>
                        }

                        <div class="d-flex align-items-center gap-4 mb-4">
                            <span class="fw-bold">Quantity</span>
                            <div class="d-flex align-items-center gap-3">
                                <button type="button" class="btn btn-outline-secondary rounded-circle" onclick="changeQty(-1)" style="width: 45px; height: 45px;">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <input type="number" name="quantity" value="1" min="1" max="10" id="qty" 
                                       class="form-control text-center fw-bold" style="width: 60px;" readonly>
                                <button type="button" class="btn btn-primary rounded-circle" onclick="changeQty(1)" style="width: 45px; height: 45px;">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100" @(Model.IsAvailable ? "" : "disabled")>
                            <i class="bi bi-cart-plus me-2"></i>@(Model.IsAvailable ? "Add to Cart" : "Currently Unavailable")
                        </button>
                    </form>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0">
                            <i class="bi bi-shield-lock me-2"></i>
                            Admin and SuperAdmin accounts cannot place customer orders. Use the Admin or POS panel instead.
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-light border">
                        <i class="bi bi-info-circle me-2"></i>
                        <a href="/Account/QuickJoin?returnUrl=/Menu/Details/@Model.Id" class="fw-bold text-primary">Continue with name &amp; phone</a>
                        or <a href="/Account/Login?returnUrl=/Menu/Details/@Model.Id" class="fw-bold text-primary">Login</a> to order
                    </div>
                    <a href="/Account/QuickJoin?returnUrl=/Menu/Details/@Model.Id" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-lightning-charge me-2"></i>Continue to order
                    </a>
                }
            </div>
        </div>

        <hr class="my-5" />

        <div class="row g-4">
            <div class="col-lg-5">
                <h4 class="fw-bold mb-3">Write a Review</h4>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="AddReview" method="post" class="card border-0 shadow-sm">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <input type="hidden" name="menuItemId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label">Rating</label>
                                <select name="rating" class="form-select" required>
                                    <option value="5">5 - Excellent</option>
                                    <option value="4">4 - Good</option>
                                    <option value="3">3 - Average</option>
                                    <option value="2">2 - Poor</option>
                                    <option value="1">1 - Bad</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Comment</label>
                                <textarea name="comment" class="form-control" rows="3"
                                          placeholder="@AppContent.Get("placeholder.review_comment", "Share your experience...")"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-chat-dots me-1"></i>Submit Review
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-light border">
                        <a href="/Account/Login?returnUrl=/Menu/Details/@Model.Id">Login</a> to leave a review.
                    </div>
                }
            </div>
            <div class="col-lg-7">
                <h4 class="fw-bold mb-3">Customer Reviews</h4>
                @if (!reviews.Any())
                {
                    <p class="text-muted">No reviews yet. Be the first to review this dish.</p>
                }
                else
                {
                    @foreach (var review in reviews)
                    {
                        <div class="border rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong>@review.UserName</strong>
                                    <div class="text-warning small">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                        }
                                    </div>
                                </div>
                                <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="mb-0 text-muted">@review.Comment</p>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    function changeQty(delta) {
        const input = document.getElementById('qty');
        let val = parseInt(input.value) + delta;
        if (val >= 1 && val <= 10) input.value = val;
    }
    
    document.querySelectorAll('input[name="variantId"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('input[name="variantId"]').forEach(r => {
                r.closest('label').classList.remove('btn-primary');
                r.closest('label').classList.add('btn-outline-primary');
            });
            this.closest('label').classList.remove('btn-outline-primary');
            this.closest('label').classList.add('btn-primary');
        });
    });

    async function shareMenuItem() {
        const data = {
            title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)),
            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"Try {Model.Name} at our restaurant")),
            url: window.location.href
        };
        if (navigator.share) {
            try { await navigator.share(data); } catch (_) {}
        } else {
            await copyMenuLink();
        }
    }

    async function copyMenuLink() {
        try {
            await navigator.clipboard.writeText(window.location.href);
            alert('Link copied!');
        } catch (_) {
            prompt('Copy this link:', window.location.href);
        }
    }
</script>
}
