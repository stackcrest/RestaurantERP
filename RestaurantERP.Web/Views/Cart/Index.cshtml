@{
    ViewData["Title"] = "Cart";
    var cartItems = ViewBag.CartItems as List<dynamic> ?? new();
    var subTotal = (decimal)ViewBag.SubTotal;
    var discount = (decimal)ViewBag.Discount;
    var tax = (decimal)ViewBag.Tax;
    var total = (decimal)ViewBag.Total;
    var discountThreshold = (decimal)ViewBag.DiscountThreshold;
    var discountPercent = (decimal)ViewBag.DiscountPercent;
}

<div class="p-3" id="cartPageRoot">
    <h1 class="h5 fw-bold mb-3">Your Cart</h1>

    @if (!cartItems.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart3 display-1 text-muted d-block mb-3"></i>
            <h5>Your cart is empty</h5>
            <p class="text-muted small">Add some delicious dishes to get started</p>
            <a href="/Menu" class="btn btn-primary mt-2">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4" id="cartLines">
            @foreach (var ci in cartItems)
            {
                var item = ci.Item as RestaurantERP.Domain.Entities.CartItem;
                var unitPrice = (decimal)ci.UnitPrice;
                var addOns = ci.AddOns as List<RestaurantERP.Domain.Entities.AddOn>;

                <div class="card" data-cart-item-id="@item!.Id">
                    <div class="card-body p-3">
                        <div class="d-flex gap-3">
                            <img src="@(item.MenuItem.ImageUrl ?? $"https://picsum.photos/seed/{item.MenuItemId}/100/100")"
                                 class="rounded" style="width: 70px; height: 70px; object-fit: cover;" alt="@item.MenuItem.Name">
                            <div class="flex-grow-1">
                                <h6 class="mb-1">@item.MenuItem.Name</h6>
                                @if (item.Variant != null)
                                {
                                    <small class="text-muted d-block">@item.Variant.Name</small>
                                }
                                @if (addOns?.Any() == true)
                                {
                                    <small class="text-muted d-block">+ @string.Join(", ", addOns.Select(a => a.Name))</small>
                                }

                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle cart-qty-minus" style="width: 32px; height: 32px;">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <span class="fw-bold cart-line-qty">@item.Quantity</span>
                                        <button type="button" class="btn btn-sm btn-primary rounded-circle cart-qty-plus" style="width: 32px; height: 32px;">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold cart-line-total">₹@((unitPrice * item.Quantity).ToString("N0"))</span>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 cart-remove-btn">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="cartDiscountAlert" class="@(subTotal < discountThreshold ? "alert alert-warning small mb-3" : discount > 0 ? "alert alert-success small mb-3" : "d-none")">
            @if (discount > 0)
            {
                <i class="bi bi-check-circle me-1"></i>@:You get @discountPercent% discount on this order!
            }
            else if (subTotal < discountThreshold)
            {
                <i class="bi bi-info-circle me-1"></i>@:Add ₹@((discountThreshold - subTotal).ToString("N0")) more to get @discountPercent% discount!
            }
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal</span>
                    <span id="cartSubtotal">₹@subTotal.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-success @(discount > 0 ? "" : "d-none")" id="cartDiscountRow">
                    <span>Discount</span>
                    <span id="cartDiscount">-₹@discount.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Tax (GST)</span>
                    <span id="cartTax">₹@tax.ToString("N0")</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between fw-bold">
                    <span>Total</span>
                    <span class="text-primary h5 mb-0" id="cartTotal">₹@total.ToString("N0")</span>
                </div>
            </div>
        </div>

        <a href="/Orders/Checkout" class="btn btn-primary w-100 py-3 rounded-4 fw-semibold" id="cartCheckoutBtn">
            Proceed to Checkout — ₹@total.ToString("N0")
        </a>
    }
</div>

@section Scripts {
    <script src="~/js/cart-page.js"></script>
}
