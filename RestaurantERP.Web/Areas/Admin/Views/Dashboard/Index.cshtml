@{
    ViewData["Title"] = "Dashboard";
    var todaySales = (decimal)ViewBag.TodaySales;
    var todayOrders = (int)ViewBag.TodayOrders;
    var avgOrder = (decimal)ViewBag.AvgOrderValue;
    var pendingOrders = (int)ViewBag.PendingOrders;
    var lowStock = (int)ViewBag.LowStock;
    var activeTables = (int)ViewBag.ActiveTables;
    var totalTables = (int)ViewBag.TotalTables;
    var recentOrders = ViewBag.RecentOrders as List<RestaurantERP.Domain.Entities.Order>;
    var chartLabels = ViewBag.ChartLabels as List<string>;
    var chartData = ViewBag.ChartData as List<decimal>;
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-currency-rupee fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Today's Sales</p>
                        <h4 class="fw-bold mb-0">₹@todaySales.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Orders</p>
                        <h4 class="fw-bold mb-0">@todayOrders</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Pending</p>
                        <h4 class="fw-bold mb-0">@pendingOrders</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Low Stock</p>
                        <h4 class="fw-bold mb-0">@lowStock</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h6 class="fw-bold">Sales (Last 7 Days)</h6>
            </div>
            <div class="card-body">
                <canvas id="salesChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h6 class="fw-bold">Table Status</h6>
            </div>
            <div class="card-body text-center">
                <div class="position-relative d-inline-block">
                    <canvas id="tableChart" width="180" height="180"></canvas>
                </div>
                <p class="mt-3 mb-0">
                    <span class="text-success fw-bold">@activeTables</span> occupied /
                    <span class="text-muted">@totalTables total</span>
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">Recent Orders</h6>
        <a href="/Admin/Orders" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in recentOrders ?? new())
                    {
                        var statusClass = order.Status switch {
                            OrderStatus.Placed => "secondary",
                            OrderStatus.Confirmed => "primary",
                            OrderStatus.Preparing => "warning",
                            OrderStatus.Ready => "info",
                            _ => "success"
                        };
                        <tr>
                            <td class="fw-medium">@order.OrderNumber</td>
                            <td>@order.User.FullName</td>
                            <td><span class="badge bg-light text-dark">@order.OrderType</span></td>
                            <td><span class="badge bg-@statusClass">@order.Status</span></td>
                            <td class="fw-bold">₹@order.TotalAmount.ToString("N0")</td>
                            <td>
                                <a href="/Admin/Orders/Details/@order.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels)),
            datasets: [{
                label: 'Sales',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartData)),
                borderColor: '#E63946',
                backgroundColor: 'rgba(230, 57, 70, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('tableChart'), {
        type: 'doughnut',
        data: {
            labels: ['Occupied', 'Available'],
            datasets: [{
                data: [@activeTables, @(totalTables - activeTables)],
                backgroundColor: ['#E63946', '#e9ecef']
            }]
        },
        options: { responsive: false, plugins: { legend: { display: false } }, cutout: '70%' }
    });
</script>
}
