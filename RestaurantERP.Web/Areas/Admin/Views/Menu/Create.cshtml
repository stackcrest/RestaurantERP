@{
    ViewData["Title"] = "Add Menu Item";
    var categories = ViewBag.Categories as List<RestaurantERP.Domain.Entities.Category>;
    var hasCategories = ViewBag.HasCategories as bool? ?? categories?.Any() == true;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (!hasCategories)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-folder-x display-4 text-warning d-block mb-3"></i>
                    <h5>No categories available</h5>
                    <p class="text-muted mb-4">You need at least one category before adding menu items.</p>
                    <a href="/Admin/Categories/Create" class="btn btn-primary me-2">Create Category</a>
                    <a href="/Admin/Menu" class="btn btn-outline-secondary">Back to Menu</a>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <p class="text-muted mb-0 small">Assign this item to a category</p>
                        <a href="/Admin/Categories/Create" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-plus me-1"></i>New Category
                        </a>
                    </div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Name *</label>
                                <input type="text" name="name" class="form-control" required />
                            </div>
                            <div class="col-md-4 mb-3" id="singlePriceWrap">
                                <label class="form-label">Price (₹) *</label>
                                <input type="number" name="basePrice" id="basePrice" class="form-control" step="0.01" required />
                            </div>
                        </div>

                        <div class="card border mb-3">
                            <div class="card-body">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="enableHalfFull" name="enableHalfFull" value="true">
                                    <label class="form-check-label fw-medium" for="enableHalfFull">Offer Half &amp; Full sizes</label>
                                </div>
                                <p class="small text-muted mb-3 mb-md-2">One menu card — customers choose Half or Full when adding to cart.</p>
                                <div class="row g-3 d-none" id="halfFullPriceWrap">
                                    <div class="col-md-6">
                                        <label class="form-label">Half price (₹) *</label>
                                        <input type="number" name="halfPrice" id="halfPrice" class="form-control" step="0.01" min="0.01" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Full price (₹) *</label>
                                        <input type="number" name="fullPrice" id="fullPrice" class="form-control" step="0.01" min="0.01" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Category *</label>
                                <select name="categoryId" class="form-select" required>
                                    <option value="">Select category</option>
                                    @foreach (var cat in categories ?? new())
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Spice Level</label>
                                <select name="spiceLevel" class="form-select">
                                    <option value="Mild">Mild</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Hot">Hot</option>
                                    <option value="ExtraHot">Extra Hot</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Preparation Time (minutes)</label>
                                <input type="number" name="preparationTime" class="form-control" value="15" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Upload Image</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
                            <div class="form-text">JPG, PNG, WEBP or GIF up to 5 MB</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Or Image URL</label>
                            <input type="text" name="imageUrl" class="form-control" placeholder="@AppContent.Get("placeholder.image_url", "https://... or /images/...")" />
                            <div class="form-text">Used when no file is uploaded</div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-check-inline">
                                <input type="checkbox" name="isVeg" value="true" class="form-check-input" id="isVeg">
                                <label class="form-check-label" for="isVeg">Vegetarian</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input type="checkbox" name="isFeatured" value="true" class="form-check-input" id="isFeatured">
                                <label class="form-check-label" for="isFeatured">Featured</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Item</button>
                            <a href="/Admin/Menu" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(() => {
    const toggle = document.getElementById('enableHalfFull');
    const singleWrap = document.getElementById('singlePriceWrap');
    const halfFullWrap = document.getElementById('halfFullPriceWrap');
    const basePrice = document.getElementById('basePrice');
    const halfPrice = document.getElementById('halfPrice');
    const fullPrice = document.getElementById('fullPrice');
    function sync() {
        const on = toggle.checked;
        halfFullWrap.classList.toggle('d-none', !on);
        singleWrap.classList.toggle('d-none', on);
        basePrice.required = !on;
        halfPrice.required = on;
        fullPrice.required = on;
        if (on && !basePrice.value && halfPrice.value) basePrice.value = halfPrice.value;
    }
    toggle.addEventListener('change', sync);
    halfPrice.addEventListener('input', () => { if (toggle.checked) basePrice.value = halfPrice.value || '0'; });
    sync();
})();
</script>
}
