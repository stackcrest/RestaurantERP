@model RestaurantERP.Domain.Entities.Order
@using RestaurantERP.Application.Interfaces
@using RestaurantERP.Domain.Enums
@{
    ViewData["Title"] = Model.OrderNumber;
    var timeline = ViewBag.Timeline as List<OrderTrackingStep> ?? new();
    var areaPrefix = ViewBag.AreaPrefix as string ?? "/Admin";
    var existingBill = ViewBag.ExistingBill as RestaurantERP.Domain.Entities.Bill;
    var posFeatures = ViewBag.PosFeatures as RestaurantERP.Application.Common.PosFeatureState;
}

<div class="mb-3 d-flex flex-wrap gap-2">
    <a href="@areaPrefix/Orders" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Orders</a>
    <a href="@areaPrefix/Orders/Tracking" class="btn btn-sm btn-outline-primary"><i class="bi bi-kanban me-1"></i>Tracking Board</a>
    @if (existingBill != null)
    {
        <a href="/Admin/Pos/Print/@existingBill.Id" target="_blank" class="btn btn-sm btn-success">
            <i class="bi bi-printer me-1"></i>Print Bill (@existingBill.BillNumber)
        </a>
    }
    else if ((posFeatures?.OnlineBilling ?? true) && Model.OrderSource == OrderSource.Web)
    {
        <form asp-area="Admin" asp-controller="Orders" asp-action="GenerateBill" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-receipt me-1"></i>Generate Bill</button>
        </form>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Order Tracking</h6>
                <partial name="_OrderStatusBadge" model="Model.Status" />
            </div>
            <div class="card-body">
                <partial name="_OrderTrackingTimeline" model="timeline" />
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Order Items</h6>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @item.MenuItemName
                                    @if (!string.IsNullOrEmpty(item.VariantName))
                                    {
                                        <small class="text-muted d-block">@item.VariantName</small>
                                    }
                                    @if (item.AddOns.Any())
                                    {
                                        <small class="text-muted d-block">+ @string.Join(", ", item.AddOns.Select(a => a.AddOnName))</small>
                                    }
                                </td>
                                <td>@item.Quantity</td>
                                <td>₹@item.UnitPrice.ToString("N0")</td>
                                <td class="fw-bold">₹@item.TotalPrice.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end">Total</td>
                            <td class="fw-bold text-primary">₹@Model.TotalAmount.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <partial name="_OrderStatusActions" model="Model" />
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Customer</h6>
            </div>
            <div class="card-body">
                <p class="mb-1 fw-medium">@Model.User.FullName</p>
                <p class="mb-1 text-muted small">@Model.User.Email</p>
                @if (!string.IsNullOrEmpty(Model.User.PhoneNumber))
                {
                    <p class="mb-0"><a href="tel:@Model.User.PhoneNumber"><i class="bi bi-telephone me-1"></i>@Model.User.PhoneNumber</a></p>
                }
            </div>
        </div>

        @if (Model.OrderType == OrderType.Delivery)
        {
            <div class="card mb-4 border-info">
                <div class="card-header bg-info bg-opacity-10">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-truck me-1"></i>Delivery Details</h6>
                </div>
                <div class="card-body small">
                    @if (!string.IsNullOrEmpty(Model.DeliveryAddress))
                    {
                        <p class="mb-2"><strong>Address:</strong><br />@Model.DeliveryAddress</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.DeliveryLandmark))
                    {
                        <p class="mb-2"><strong>Landmark:</strong> @Model.DeliveryLandmark</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.DeliveryCity) || !string.IsNullOrEmpty(Model.DeliveryPinCode))
                    {
                        <p class="mb-2">@Model.DeliveryCity @Model.DeliveryPinCode</p>
                    }
                    @if (Model.DeliveryDistanceKm.HasValue)
                    {
                        <p class="mb-2"><i class="bi bi-rulers me-1"></i><strong>@Model.DeliveryDistanceKm.Value.ToString("F1") km</strong> from restaurant</p>
                    }
                    @if (Model.DeliveryLatitude.HasValue && Model.DeliveryLongitude.HasValue)
                    {
                        <a href="https://www.openstreetmap.org/?mlat=@Model.DeliveryLatitude&mlon=@Model.DeliveryLongitude#map=16/@Model.DeliveryLatitude/@Model.DeliveryLongitude"
                           target="_blank" class="btn btn-sm btn-outline-info w-100">
                            <i class="bi bi-map me-1"></i>View on Map
                        </a>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Order Info</h6>
            </div>
            <div class="card-body small">
                <div class="row mb-2">
                    <div class="col-5 text-muted">Type</div>
                    <div class="col-7 fw-medium">@Model.OrderType</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Payment</div>
                    <div class="col-7 fw-medium">@Model.PaymentMethod — @Model.PaymentStatus</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Placed at</div>
                    <div class="col-7 fw-medium">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
                @if (Model.Table != null)
                {
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Table</div>
                        <div class="col-7 fw-medium">@Model.Table.TableNumber</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="row">
                        <div class="col-5 text-muted">Notes</div>
                        <div class="col-7">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
