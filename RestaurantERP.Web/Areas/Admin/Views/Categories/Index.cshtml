@model List<RestaurantERP.Domain.Entities.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0 small">Organize your menu into categories before adding items.</p>
    </div>
    <a href="/Admin/Categories/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Category
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-folder-plus display-4 text-muted d-block mb-3"></i>
            <h5>No categories yet</h5>
            <p class="text-muted mb-4">Create at least one category before adding menu items.</p>
            <a href="/Admin/Categories/Create" class="btn btn-primary">Create First Category</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 56px;"></th>
                            <th>Order</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Items</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(cat.ImageUrl))
                                    {
                                        <img src="@cat.ImageUrl" alt="@cat.Name" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-image text-primary"></i>
                                        </div>
                                    }
                                </td>
                                <td class="text-muted">@cat.DisplayOrder</td>
                                <td class="fw-medium">@cat.Name</td>
                                <td class="text-muted small text-truncate" style="max-width: 200px;">@(cat.Description ?? "—")</td>
                                <td><span class="badge bg-light text-dark">@cat.MenuItems.Count(m => !m.IsDeleted) items</span></td>
                                <td>
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm @(cat.IsActive ? "btn-success" : "btn-secondary")">
                                            @(cat.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <a href="/Admin/Categories/Edit/@cat.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this category?')">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
