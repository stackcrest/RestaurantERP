@using RestaurantERP.Application.Common
@{
    var sectionAccess = ViewData["AdminSectionAccess"] as Dictionary<string, (bool CanRead, bool CanWrite)>;
    bool CanRead(string key) => sectionAccess != null && sectionAccess.TryGetValue(key, out var access) && access.CanRead;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        :root { --primary: #E63946; --secondary: #1D3557; }
        .sidebar { width: 250px; min-height: 100vh; background: var(--secondary); }
        .sidebar .nav-link { color: rgba(255,255,255,0.7); padding: 12px 20px; border-radius: 8px; margin: 4px 12px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(255,255,255,0.1); color: #fff; }
        .sidebar .nav-link i { width: 24px; }
        .main-content { flex: 1; background: #f8f9fa; min-height: 100vh; }
        .stat-card { border: none; border-radius: 16px; }
        .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .table th { font-weight: 600; font-size: 0.85rem; text-transform: uppercase; color: #6c757d; }
        @@media (max-width: 992px) {
            .sidebar { width: 100%; min-height: auto; }
            .d-flex { flex-direction: column; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@await Html.PartialAsync("_NotificationBar")
<div class="d-flex">
    <nav class="sidebar d-none d-lg-block">
        <div class="p-4">
            <h4 class="text-white fw-bold mb-0">Restaurant ERP</h4>
            <small class="text-white-50">Admin Panel</small>
        </div>
        <ul class="nav flex-column px-2">
            @if (CanRead(AdminMenuSections.Dashboard))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/Admin">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Orders))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" href="/Admin/Orders">
                        <i class="bi bi-receipt me-2"></i> Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Tracking" ? "active" : "")" href="/Admin/Orders/Tracking" style="padding-left: 48px; font-size: 0.9rem;">
                        <i class="bi bi-kanban me-2"></i> Tracking Board
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Pos))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pos" ? "active" : "")" href="/Admin/Pos">
                        <i class="bi bi-cash-stack me-2"></i> POS / Billing
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Bills" ? "active" : "")" href="/Admin/Pos/Bills" style="padding-left: 48px; font-size: 0.9rem;">
                        <i class="bi bi-printer me-2"></i> Bills
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Categories))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" href="/Admin/Categories">
                        <i class="bi bi-folder me-2"></i> Categories
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.MenuItems))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")" href="/Admin/Menu">
                        <i class="bi bi-grid me-2"></i> Menu Items
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Tables))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")" href="/Admin/Tables">
                        <i class="bi bi-columns-gap me-2"></i> Tables
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Inventory))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")" href="/Admin/Inventory">
                        <i class="bi bi-box-seam me-2"></i> Inventory
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Reports))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="/Admin/Reports">
                        <i class="bi bi-bar-chart me-2"></i> Reports
                    </a>
                </li>
            }
            @if (CanRead(AdminMenuSections.Contact))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" href="/Admin/Contact">
                        <i class="bi bi-envelope me-2"></i> Contact Us
                    </a>
                </li>
            }
            <li class="nav-item mt-4">
                <a class="nav-link" href="/">
                    <i class="bi bi-arrow-left me-2"></i> Back to Site
                </a>
            </li>
        </ul>
    </nav>

    <div class="main-content">
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
            <div class="d-lg-none">
                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-md-inline">@User.Identity?.Name</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
                </form>
            </div>
        </header>

        <main class="p-4">
            @RenderBody()
        </main>
    </div>
</div>

<div class="offcanvas offcanvas-start d-lg-none" id="mobileMenu" style="background: #1D3557;">
    <div class="offcanvas-header">
        <h5 class="text-white">Menu</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="nav flex-column">
            @if (CanRead(AdminMenuSections.Dashboard))
            {
                <li><a class="nav-link text-white" href="/Admin"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
            }
            @if (CanRead(AdminMenuSections.Orders))
            {
                <li><a class="nav-link text-white" href="/Admin/Orders"><i class="bi bi-receipt me-2"></i> Orders</a></li>
            }
            @if (CanRead(AdminMenuSections.Pos))
            {
                <li><a class="nav-link text-white" href="/Admin/Pos"><i class="bi bi-cash-stack me-2"></i> POS</a></li>
            }
            @if (CanRead(AdminMenuSections.Categories))
            {
                <li><a class="nav-link text-white" href="/Admin/Categories"><i class="bi bi-folder me-2"></i> Categories</a></li>
            }
            @if (CanRead(AdminMenuSections.MenuItems))
            {
                <li><a class="nav-link text-white" href="/Admin/Menu"><i class="bi bi-grid me-2"></i> Menu Items</a></li>
            }
            @if (CanRead(AdminMenuSections.Tables))
            {
                <li><a class="nav-link text-white" href="/Admin/Tables"><i class="bi bi-columns-gap me-2"></i> Tables</a></li>
            }
            @if (CanRead(AdminMenuSections.Inventory))
            {
                <li><a class="nav-link text-white" href="/Admin/Inventory"><i class="bi bi-box-seam me-2"></i> Inventory</a></li>
            }
            @if (CanRead(AdminMenuSections.Reports))
            {
                <li><a class="nav-link text-white" href="/Admin/Reports"><i class="bi bi-bar-chart me-2"></i> Reports</a></li>
            }
            @if (CanRead(AdminMenuSections.Contact))
            {
                <li><a class="nav-link text-white" href="/Admin/Contact"><i class="bi bi-envelope me-2"></i> Contact Us</a></li>
            }
            <li><a class="nav-link text-white" href="/"><i class="bi bi-arrow-left me-2"></i> Back to Site</a></li>
        </ul>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/notification-bar.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
