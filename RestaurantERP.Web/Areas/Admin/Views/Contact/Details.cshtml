@model RestaurantERP.Domain.Entities.ContactInquiry
@using RestaurantERP.Domain.Enums
@{
    ViewData["Title"] = "Contact Inquiry";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a href="/Admin/Contact" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Inquiries
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">@Model.Subject</h6>
                @{
                    var statusClass = Model.Status switch
                    {
                        ContactInquiryStatus.New => "bg-danger",
                        ContactInquiryStatus.InProgress => "bg-warning text-dark",
                        ContactInquiryStatus.Resolved => "bg-success",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @statusClass">@Model.Status</span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Name</small>
                        <strong>@Model.Name</strong>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Email</small>
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Phone</small>
                        <span>@(Model.Phone ?? "—")</span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Submitted</small>
                        <span>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                </div>
                <h6 class="fw-bold mb-2">Message</h6>
                <div class="bg-light rounded p-3" style="white-space: pre-wrap;">@Model.Message</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Update Status</h6>
            </div>
            <div class="card-body">
                <form method="post" asp-action="Update">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            @foreach (ContactInquiryStatus status in Enum.GetValues(typeof(ContactInquiryStatus)))
                            {
                                if (Model.Status == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin Notes</label>
                        <textarea name="adminNotes" class="form-control" rows="4" placeholder="Internal notes about this inquiry...">@Model.AdminNotes</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                </form>
            </div>
        </div>

        @if (Model.HandledAt.HasValue)
        {
            <div class="card mb-4">
                <div class="card-body small text-muted">
                    <i class="bi bi-person-check me-1"></i>
                    Handled by <strong>@(Model.HandledBy?.FullName ?? "Staff")</strong>
                    on @Model.HandledAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        }

        <form method="post" asp-action="Delete" onsubmit="return confirm('Delete this inquiry permanently?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger w-100">
                <i class="bi bi-trash me-1"></i> Delete Inquiry
            </button>
        </form>
    </div>
</div>
