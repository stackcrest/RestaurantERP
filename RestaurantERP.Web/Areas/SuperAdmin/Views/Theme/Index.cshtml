@model RestaurantERP.Domain.Entities.ThemeSetting
@{
    ViewData["Title"] = "Theme Management";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Brand Settings</h6>
            </div>
            <div class="card-body">
                <form asp-action="Save" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Restaurant Name</label>
                            <input type="text" name="restaurantName" class="form-control" value="@Model.RestaurantName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tagline</label>
                            <input type="text" name="tagline" class="form-control" value="@Model.Tagline" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Logo URL</label>
                            <input type="url" name="logoUrl" class="form-control" value="@Model.LogoUrl" placeholder="https://..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Favicon URL</label>
                            <input type="url" name="faviconUrl" class="form-control" value="@Model.FaviconUrl" placeholder="https://..." />
                        </div>
                    </div>

                    <hr class="my-4">
                    <h6 class="fw-bold mb-3">Color Palette</h6>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Primary Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" value="@(Model.PrimaryColor ?? "#E63946")" 
                                       onchange="document.getElementById('primaryHex').value = this.value">
                                <input type="text" id="primaryHex" name="primaryColor" class="form-control" value="@(Model.PrimaryColor ?? "#E63946")" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Secondary Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" value="@(Model.SecondaryColor ?? "#1D3557")"
                                       onchange="document.getElementById('secondaryHex').value = this.value">
                                <input type="text" id="secondaryHex" name="secondaryColor" class="form-control" value="@(Model.SecondaryColor ?? "#1D3557")" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Accent Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" value="@(Model.AccentColor ?? "#F4A261")"
                                       onchange="document.getElementById('accentHex').value = this.value">
                                <input type="text" id="accentHex" name="accentColor" class="form-control" value="@(Model.AccentColor ?? "#F4A261")" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Surface Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" value="@(Model.SurfaceColor ?? "#F8F9FA")"
                                       onchange="document.getElementById('surfaceHex').value = this.value">
                                <input type="text" id="surfaceHex" name="surfaceColor" class="form-control" value="@(Model.SurfaceColor ?? "#F8F9FA")" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check me-1"></i> Save & Publish
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Preview</h6>
            </div>
            <div class="card-body">
                <div class="border rounded p-3" style="background: @(Model.SurfaceColor ?? "#F8F9FA");">
                    <div class="p-3 rounded text-white text-center mb-3" style="background: linear-gradient(135deg, @(Model.SecondaryColor ?? "#1D3557"), @(Model.PrimaryColor ?? "#E63946"));">
                        <h6 class="mb-1">@(Model.RestaurantName ?? "Restaurant Name")</h6>
                        <small>@(Model.Tagline ?? "Your tagline here")</small>
                    </div>
                    <button class="btn w-100 text-white" style="background: @(Model.PrimaryColor ?? "#E63946");">Order Now</button>
                    <div class="mt-3 p-2 bg-white rounded">
                        <small class="text-muted">Menu Item</small>
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Butter Chicken</span>
                            <span class="fw-bold" style="color: @(Model.PrimaryColor ?? "#E63946");">₹320</span>
                        </div>
                    </div>
                </div>
                <small class="text-muted d-block mt-2">Version: @Model.Version</small>
            </div>
        </div>
    </div>
</div>
