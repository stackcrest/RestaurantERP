@model List<RestaurantERP.Domain.Entities.UiPage>
@{
    ViewData["Title"] = "CMS Pages";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div></div>
    <a href="/SuperAdmin/Pages/Create" class="btn btn-primary"><i class="bi bi-plus me-1"></i> Create Page</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Slug</th>
                        <th>Visibility</th>
                        <th>Status</th>
                        <th>Blocks</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pg in Model)
                    {
                        var statusClass = pg.Status == PageStatus.Published ? "success" : pg.Status == PageStatus.Draft ? "secondary" : "warning";
                        <tr>
                            <td class="fw-medium">@pg.Title</td>
                            <td class="text-muted">/@pg.Slug</td>
                            <td><span class="badge bg-light text-dark">@pg.Visibility</span></td>
                            <td><span class="badge bg-@statusClass">@pg.Status</span></td>
                            <td>@pg.Blocks.Count</td>
                            <td class="text-muted small">@pg.UpdatedAt.ToString("MMM dd")</td>
                            <td>
                                <a href="/SuperAdmin/Pages/Edit/@pg.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this page?')">
                                    <input type="hidden" name="id" value="@pg.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
