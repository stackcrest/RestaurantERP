@model List<RestaurantERP.Domain.Entities.NavigationMenu>
@{
    ViewData["Title"] = "Navigation Links";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_SuperAdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-muted mb-0">Manage header and footer navigation links dynamically.</p>
    <a href="/SuperAdmin/Application" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Content
    </a>
</div>

@foreach (var menu in Model)
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0 fw-bold">@menu.Name</h6>
            <small class="text-muted">Key: <code>@menu.MenuKey</code></small>
        </div>
        <div class="card-body">
            @foreach (var item in menu.Items.OrderBy(i => i.DisplayOrder))
            {
                <div class="border rounded p-3 mb-3">
                    <form method="post" asp-action="SaveNavItem" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="menuId" value="@menu.Id" />
                        <div class="col-md-3">
                            <label class="form-label small">Label</label>
                            <input type="text" name="label" class="form-control form-control-sm" value="@item.Label" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">URL</label>
                            <input type="text" name="url" class="form-control form-control-sm" value="@item.Url" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Icon</label>
                            <input type="text" name="icon" class="form-control form-control-sm" value="@item.Icon" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">Order</label>
                            <input type="number" name="displayOrder" class="form-control form-control-sm" value="@item.DisplayOrder" />
                        </div>
                        <div class="col-md-2">
                            <div class="form-check">
                                <input type="checkbox" name="isActive" value="true" class="form-check-input" @(item.IsActive ? "checked" : "") />
                                <label class="form-check-label small">Active</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="openInNewTab" value="true" class="form-check-input" @(item.OpenInNewTab ? "checked" : "") />
                                <label class="form-check-label small">New tab</label>
                            </div>
                        </div>
                        <div class="col-md-1 d-flex gap-1">
                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        </div>
                    </form>
                    <form method="post" asp-action="DeleteNavItem" class="mt-2" onsubmit="return confirm('Remove this link?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Remove</button>
                    </form>
                </div>
            }

            <div class="border rounded p-3 bg-light">
                <h6 class="small fw-bold text-muted mb-3">Add New Link</h6>
                <form method="post" asp-action="SaveNavItem" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="menuId" value="@menu.Id" />
                    <div class="col-md-3">
                        <input type="text" name="label" class="form-control form-control-sm" placeholder="Label" required />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="url" class="form-control form-control-sm" placeholder="/Menu" required />
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="icon" class="form-control form-control-sm" placeholder="bi-house" />
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="displayOrder" class="form-control form-control-sm" value="@(menu.Items.Count + 1)" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check">
                            <input type="checkbox" name="isActive" value="true" class="form-check-input" checked />
                            <label class="form-check-label small">Active</label>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm btn-success w-100">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
