@model List<RestaurantERP.Domain.Entities.AppContentItem>
@{
    ViewData["Title"] = "Application Management";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_SuperAdminLayout.cshtml";
    var sections = ViewBag.Sections as string[] ?? Array.Empty<string>();
    var activeSection = ViewBag.ActiveSection as string ?? "Site";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <p class="text-muted mb-0">Manage all static text, links, images, and files across the public site — no code changes needed.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/SuperAdmin/Application/Navigation" class="btn btn-outline-primary">
            <i class="bi bi-list-ul me-1"></i> Navigation Links
        </a>
        <a href="/SuperAdmin/Application/Create?section=@activeSection" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Custom Item
        </a>
    </div>
</div>

<ul class="nav nav-pills mb-4 flex-wrap gap-1">
    @foreach (var sec in sections)
    {
        <li class="nav-item">
            <a class="nav-link @(sec == activeSection ? "active" : "")" href="/SuperAdmin/Application?section=@sec">@sec</a>
        </li>
    }
</ul>

<form method="post" asp-action="BulkSave" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="section" value="@activeSection" />

    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="bi bi-sliders me-2"></i>@activeSection Content</h6>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-check2-all me-1"></i> Save Section
            </button>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">No content items in this section yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:18%">Label</th>
                                <th style="width:14%">Key</th>
                                <th style="width:8%">Type</th>
                                <th>Value</th>
                                <th style="width:8%">Live</th>
                                <th style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.Label</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <small class="text-muted">@item.Description</small>
                                        }
                                    </td>
                                    <td><code class="small">@item.ContentKey</code></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary">@item.ContentType</span></td>
                                    <td>
                                        @if (item.ContentType == RestaurantERP.Domain.Enums.AppContentType.Html)
                                        {
                                            <textarea name="item_@item.Id" class="form-control form-control-sm" rows="3">@item.Value</textarea>
                                        }
                                        else if (item.ContentType == RestaurantERP.Domain.Enums.AppContentType.Text)
                                        {
                                            <input type="text" name="item_@item.Id" class="form-control form-control-sm" value="@item.Value" />
                                        }
                                        else if (item.ContentType == RestaurantERP.Domain.Enums.AppContentType.Url)
                                        {
                                            <input type="url" name="item_@item.Id" class="form-control form-control-sm" value="@item.Value" placeholder="https://..." />
                                        }
                                        else if (item.ContentType is RestaurantERP.Domain.Enums.AppContentType.Image or RestaurantERP.Domain.Enums.AppContentType.File)
                                        {
                                            <input type="text" name="item_@item.Id" class="form-control form-control-sm mb-1" value="@item.Value" placeholder="URL or upload below" />
                                            @if (item.ContentType == RestaurantERP.Domain.Enums.AppContentType.Image && !string.IsNullOrEmpty(item.Value))
                                            {
                                                <img src="@item.Value" alt="preview" class="rounded mb-1" style="max-height:48px;max-width:120px;object-fit:cover;" />
                                            }
                                            <input type="file" name="upload_@item.Id" class="form-control form-control-sm" accept="image/*,.pdf,.svg" />
                                        }
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox" name="published_@item.Id" class="form-check-input" @(item.IsPublished ? "checked" : "") />
                                    </td>
                                    <td>
                                        <a href="/SuperAdmin/Application/Edit/@item.Id" class="btn btn-sm btn-outline-secondary" title="Full editor">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (!item.IsSystem)
                                        {
                                            <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Delete this custom item?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="section" value="@activeSection" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</form>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet" />
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
        $('textarea[name^="item_"]').each(function () {
            var row = $(this).closest('tr');
            if (row.find('.badge').text() === 'Html') {
                $(this).summernote({ height: 120, toolbar: [['style', ['bold', 'italic']], ['para', ['ul', 'ol']], ['insert', ['link']]] });
            }
        });
    </script>
}
