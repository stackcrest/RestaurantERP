@model RestaurantERP.Web.Models.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_SuperAdminLayout.cshtml";
    var userRoles = ViewBag.UserRoles as IList<string> ?? new List<string>();
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a href="/SuperAdmin/Users/Details/@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to User
    </a>
    <span class="text-muted small">
        Roles:
        @foreach (var role in userRoles)
        {
            <span class="badge bg-secondary me-1">@role</span>
        }
    </span>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit User</h6>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger @(ViewData.ModelState.ErrorCount > 0 ? "" : "d-none")"></div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Account</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-medium"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-medium"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LoyaltyPoints" class="form-label fw-medium"></label>
                            <input asp-for="LoyaltyPoints" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">Active account</label>
                            </div>
                        </div>
                    </div>

                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Address</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-medium"></label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="City" class="form-label fw-medium"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-5">
                            <label asp-for="PinCode" class="form-label fw-medium"></label>
                            <input asp-for="PinCode" class="form-control" />
                        </div>
                    </div>

                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Reset Password <span class="fw-normal">(optional)</span></h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label fw-medium"></label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-medium"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                        <a href="/SuperAdmin/Users/Details/@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
