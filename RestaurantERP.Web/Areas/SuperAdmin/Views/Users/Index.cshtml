@model List<RestaurantERP.Domain.Entities.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<Guid, IList<string>>;
    var currentRole = ViewBag.CurrentRole as string;
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Identity.IdentityRole<Guid>>;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="btn-group">
        <a href="/SuperAdmin/Users" class="btn @(string.IsNullOrEmpty(currentRole) ? "btn-primary" : "btn-outline-secondary")">All</a>
        @foreach (var role in roles ?? new())
        {
            <a href="/SuperAdmin/Users?role=@role.Name" class="btn @(currentRole == role.Name ? "btn-primary" : "btn-outline-secondary")">@role.Name</a>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-secondary fs-6">@Model.Count users</span>
        <a href="/SuperAdmin/Users/Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Create User
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.UtcNow;
                        <tr>
                            <td class="fw-medium">@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>
                                @foreach (var role in userRoles?[user.Id] ?? new List<string>())
                                {
                                    var badgeClass = role switch {
                                        "SuperAdmin" => "bg-danger",
                                        "Admin" => "bg-primary",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @badgeClass me-1">@role</span>
                                }
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-muted small">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-nowrap">
                                <a href="/SuperAdmin/Users/Details/@user.Id" class="btn btn-sm btn-outline-primary">View</a>
                                <a href="/SuperAdmin/Users/Edit/@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
