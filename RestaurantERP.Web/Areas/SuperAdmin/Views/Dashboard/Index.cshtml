@{
    ViewData["Title"] = "Dashboard";
    var totalUsers = (int)ViewBag.TotalUsers;
    var totalOrders = (int)ViewBag.TotalOrders;
    var totalRevenue = (decimal)ViewBag.TotalRevenue;
    var monthlyRevenue = (decimal)ViewBag.MonthlyRevenue;
    var totalCommission = (decimal)ViewBag.TotalCommission;
    var monthlyCommission = (decimal)ViewBag.MonthlyCommission;
    var activeFeatures = (int)ViewBag.ActiveFeatures;
    var totalPages = (int)ViewBag.TotalPages;
    var recentLogs = ViewBag.RecentLogs as List<RestaurantERP.Domain.Entities.AuditLog>;
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10">
                        <i class="bi bi-people text-primary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Total Users</p>
                        <h4 class="fw-bold mb-0">@totalUsers</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10">
                        <i class="bi bi-currency-rupee text-success fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Total Revenue</p>
                        <h4 class="fw-bold mb-0">₹@totalRevenue.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10">
                        <i class="bi bi-percent text-warning fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Commission Earned</p>
                        <h4 class="fw-bold mb-0">₹@totalCommission.ToString("N2")</h4>
                        <small class="text-muted">₹@monthlyCommission.ToString("N2") this month</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10">
                        <i class="bi bi-receipt text-info fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Total Orders</p>
                        <h4 class="fw-bold mb-0">@totalOrders</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white border-0 pt-4">
                <h6 class="fw-bold">Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <a href="/SuperAdmin/Theme" class="btn btn-outline-primary text-start">
                        <i class="bi bi-palette me-2"></i> Manage Theme
                    </a>
                    <a href="/SuperAdmin/Settings" class="btn btn-outline-primary text-start">
                        <i class="bi bi-gear me-2"></i> Application Settings
                    </a>
                    <a href="/SuperAdmin/Users" class="btn btn-outline-primary text-start">
                        <i class="bi bi-person-plus me-2"></i> Manage Users
                    </a>
                    <a href="/SuperAdmin/Pages" class="btn btn-outline-primary text-start">
                        <i class="bi bi-file-earmark-plus me-2"></i> Create CMS Page
                    </a>
                    <a href="/SuperAdmin/Blog" class="btn btn-outline-primary text-start">
                        <i class="bi bi-journal-richtext me-2"></i> Manage Blog
                    </a>
                    <a href="/SuperAdmin/Commission" class="btn btn-outline-primary text-start">
                        <i class="bi bi-percent me-2"></i> Commission Rules
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header bg-white border-0 pt-4 d-flex justify-content-between">
                <h6 class="fw-bold mb-0">Recent Activity</h6>
                <a href="/SuperAdmin/AuditLogs" class="btn btn-sm btn-link">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in recentLogs ?? new())
                            {
                                <tr>
                                    <td class="small">@log.UserEmail</td>
                                    <td><span class="badge bg-light text-dark">@log.Action</span></td>
                                    <td class="small text-muted">@log.EntityType</td>
                                    <td class="small text-muted">@log.CreatedAt.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
