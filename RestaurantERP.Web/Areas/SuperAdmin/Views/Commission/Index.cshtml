@model List<RestaurantERP.Domain.Entities.CommissionRule>
@{
    ViewData["Title"] = "Commission Management";
    var totalEarned = (decimal)ViewBag.TotalEarned;
    var monthlyEarned = (decimal)ViewBag.MonthlyEarned;
    var recentEntries = ViewBag.RecentEntries as List<RestaurantERP.Domain.Entities.CommissionLedger> ?? new();
}

<div class="row mb-4 g-3">
    <div class="col-md-4">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <h6 class="opacity-75">Total Commission Earned</h6>
                <h2 class="fw-bold mb-0">₹@totalEarned.ToString("N2")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <h6 class="opacity-75">This Month</h6>
                <h2 class="fw-bold mb-0">₹@monthlyEarned.ToString("N2")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted">Commission Entries</h6>
                <h2 class="fw-bold mb-0">@recentEntries.Count <span class="fs-6 text-muted fw-normal">recent shown</span></h2>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">Commission Rules</h6>
        <a href="/SuperAdmin/Commission/Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus"></i> Add Rule
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">
                No commission rules yet. <a href="/SuperAdmin/Commission/Create">Create a rule</a> to start earning platform commission on orders.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Rate</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model)
                        {
                            <tr>
                                <td class="fw-medium">@rule.Name</td>
                                <td>@rule.Percentage%</td>
                                <td>@rule.Priority</td>
                                <td>
                                    <form asp-action="Toggle" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@rule.Id" />
                                        <button type="submit" class="btn btn-sm @(rule.IsActive ? "btn-success" : "btn-secondary")">
                                            @(rule.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this rule?')">
                                        <input type="hidden" name="id" value="@rule.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <h6 class="mb-0 fw-bold">Recent Commission Earned</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Order</th>
                        <th>Rule</th>
                        <th>Order Amount</th>
                        <th>Rate</th>
                        <th class="text-end">Commission</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in recentEntries)
                    {
                        <tr>
                            <td class="small text-muted">@entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="fw-medium">@entry.Order?.OrderNumber</td>
                            <td>@entry.CommissionRule?.Name</td>
                            <td>₹@entry.OrderAmount.ToString("N2")</td>
                            <td>@entry.CommissionPercentage%</td>
                            <td class="text-end fw-bold text-success">₹@entry.CommissionAmount.ToString("N2")</td>
                        </tr>
                    }
                    @if (!recentEntries.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No commission recorded yet. Commission is applied when customers place orders.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
