@model List<RestaurantERP.Domain.Entities.ApplicationSetting>
@{
    ViewData["Title"] = "Application Settings";
    var features = ViewBag.Features as List<RestaurantERP.Domain.Entities.FeatureFlag>;
    var groups = Model.Select(s => s.Group ?? "General").Distinct().ToList();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Settings</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSettingModal">
                    <i class="bi bi-plus"></i> Add Setting
                </button>
            </div>
            <div class="card-body p-0">
                @foreach (var grp in groups)
                {
                    <div class="p-3 bg-light border-bottom">
                        <strong>@grp</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <tbody>
                                @foreach (var setting in Model.Where(s => (s.Group ?? "General") == grp))
                                {
                                    <tr>
                                        <td style="width: 200px;">
                                            <span class="fw-medium">@setting.Key</span>
                                            @if (!string.IsNullOrEmpty(setting.Description))
                                            {
                                                <small class="d-block text-muted">@setting.Description</small>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="SaveSetting" method="post" class="d-flex gap-2">
                                                <input type="hidden" name="key" value="@setting.Key" />
                                                <input type="text" name="value" value="@setting.Value" class="form-control form-control-sm" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold">Feature Flags</h6>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var feature in features ?? new())
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-medium">@feature.Name</span>
                                @if (!string.IsNullOrEmpty(feature.Description))
                                {
                                    <small class="d-block text-muted">@feature.Description</small>
                                }
                            </div>
                            <form asp-action="ToggleFeature" method="post">
                                <input type="hidden" name="id" value="@feature.Id" />
                                <button type="submit" class="btn btn-sm @(feature.IsEnabled ? "btn-success" : "btn-secondary")">
                                    @(feature.IsEnabled ? "ON" : "OFF")
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addSettingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddSetting" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add Setting</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Key</label>
                        <input type="text" name="key" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Value</label>
                        <input type="text" name="value" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Group</label>
                        <input type="text" name="group" class="form-control" value="General" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" name="description" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Setting</button>
                </div>
            </form>
        </div>
    </div>
</div>
