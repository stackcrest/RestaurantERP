@model RestaurantERP.Domain.Entities.BlogPost
@{
    ViewData["Title"] = "Edit Blog Post";
}

<div class="row">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0 fw-bold">Edit: @Model.Title</h6>
                @if (Model.Status == PageStatus.Published)
                {
                    <a href="/Blog/Post/@Model.Slug" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-up-right me-1"></i> View Live
                    </a>
                }
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="@Model.Id" />
                    @await Html.PartialAsync("_BlogForm", Model)
                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a href="/SuperAdmin/Blog" class="btn btn-outline-secondary">Back to List</a>
                    </div>
                </form>
                <form asp-action="Delete" method="post" class="mt-3 text-end" onsubmit="return confirm('Delete this post permanently?')">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger">Delete Post</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet" />
}

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
<script src="~/js/blog-editor.js"></script>
}
