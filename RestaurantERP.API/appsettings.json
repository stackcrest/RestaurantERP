{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=RestaurantERP;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Secret": "RestaurantERP-SuperSecret-Key-Min32Chars-Long!",
    "Issuer": "RestaurantERP",
    "Audience": "RestaurantERPClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "BusinessRules": {
    "DiscountThresholdAmount": 500,
    "DiscountPercentage": 5,
    "CGST": 2.5,
    "SGST": 2.5,
    "DeliveryFee": 40,
    "ServiceChargePercentage": 0,
    "MinimumOrderAmount": 100
  },
  "Commission": {
    "DefaultPercentage": 2.5,
    "SettlementCycle": "Weekly"
  },
  "Theme": {
    "PrimaryColor": "#E63946",
    "SecondaryColor": "#1D3557",
    "AccentColor": "#F4A261",
    "RestaurantName": "Restaurant ERP",
    "Tagline": "Delicious food, delivered fast"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/restaurant-erp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:4200" ]
  }
}
